# Copy to .env (gitignored) and fill in. Never commit real values.

# --- PostgreSQL (Supabase, Session pooler) ---
# 20-char ref only (the part between https:// and .supabase.co), not the URL
SUPABASE_PROJECT_REF=
# Copy from Connect -> Session pooler; this project uses the aws-1 pooler (aws-0 returns "tenant/user not found")
DATABASE_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=dataset
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=secrets/supabase-ca.crt
DATABASE_USER=astra_analyst
DATABASE_PASSWORD=
REPORTING_DB_USER=astra_reporting
REPORTING_DB_PASSWORD=

# --- Telegram alerts / bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM for the n8n AI agent (provider-neutral; Gemini first) ---
LLM_MODEL=
LLM_MODEL_KEY=

# --- n8n ---
N8N_BASE_URL=http://astra.localhost:5698
# Leave EMPTY: native n8n already keeps its key in %USERPROFILE%\.n8n\config.
# A different value here makes n8n refuse to start ("Mismatching encryption keys").
N8N_ENCRYPTION_KEY=

# --- Laya local decision engine (no API key, no per-request cost) ---
LAYA_CHECKPOINT=multilingual
LAYA_THREADS=4
LAYA_API_HOST=127.0.0.1
LAYA_API_PORT=8765
LAYA_API_TOKEN=
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_SYMLINKS_WARNING=1
